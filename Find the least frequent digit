class Solution {
public:
    int getLeastFrequentDigit(int n) {
        vector<int> v(10,0);
        while(n>0){
            int a = n % 10;
            v[a]++;
            n = n / 10;
        }
        int maxi = 1e9;
        int val = 0;
        for(int i = 0 ; i < 10; i++){
            if(v[i]>0 && v[i]<maxi){
                maxi = v[i];
                val = i;
            }
        }
        return val;
    }
};
