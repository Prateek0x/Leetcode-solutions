class Solution {
public:
    int addDigits(int num) 
    {
        while(num>9)
        {
            num = digsum(num);
        }
        return num;
    }
    int digsum(int n)
    {
        int s = 0;
        while(n>0)
        {
            s += n%10;
            n=n/10;
        }
        return s;
    }
//please upvote...
};
