class Solution {
public:
    bool canReach(vector<int>& start, vector<int>& target) {

        int firstDifference = abs(target[0]-start[0]);
        int secondDifference = abs(target[1]-start[1]);

        int total_distance = firstDifference + secondDifference;
        
        return total_distance%2==0;
    }
};
