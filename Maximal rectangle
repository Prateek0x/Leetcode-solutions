class Solution {
public:

    int largestRectangleArea(vector<int>& arr) {

        int n = arr.size();

        vector<int> left(n), right(n);

        stack<int> st;

        // Next Smaller Left

        for(int i = 0; i < n; i++) {

            while(!st.empty() && arr[st.top()] >= arr[i])
                st.pop();

            if(st.empty())
                left[i] = 0;
            else
                left[i] = st.top() + 1;

            st.push(i);
        }

        while(!st.empty())
            st.pop();

        // Next Smaller Right

        for(int i = n-1; i >= 0; i--) {

            while(!st.empty() && arr[st.top()] >= arr[i])
                st.pop();

            if(st.empty())
                right[i] = n-1;
            else
                right[i] = st.top() - 1;

            st.push(i);
        }

        // Maximum Area

        int maxArea = 0;

        for(int i = 0; i < n; i++) {

            int width = right[i] - left[i] + 1;

            int area = arr[i] * width;

            maxArea = max(maxArea, area);
        }

        return maxArea;
    }


    int maximalRectangle(vector<vector<char>>& matrix) {

        int n = matrix.size();

        if(n == 0) return 0;

        int m = matrix[0].size();

        int maxArea = 0;

        vector<vector<int>> prefixSum(n, vector<int>(m, 0));

        // Prefix Sum

        for(int j = 0; j < m; j++) {

            int sum = 0;

            for(int i = 0; i < n; i++) {

                sum += (matrix[i][j] - '0');

                if(matrix[i][j] == '0')
                    sum = 0;

                prefixSum[i][j] = sum;
            }
        }

        // Maximum Rectangle in each row

        for(int i = 0; i < n; i++) {

            maxArea = max(maxArea,
                          largestRectangleArea(prefixSum[i]));
        }

        return maxArea;
    }
