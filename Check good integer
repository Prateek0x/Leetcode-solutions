class Solution {
public:
    bool checkGoodInteger(int n) {
        int newN = n;
        int digitSum=0;
        int squareSum = 0;
        while(newN>0){
            int digit = newN%10;
            digitSum += digit;
            squareSum += digit*digit;
            newN /= 10;
        }
        int diff = squareSum - digitSum;
        return diff >=50?true:false;
    }
};
