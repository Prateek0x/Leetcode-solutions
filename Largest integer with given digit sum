class Solution {
public:
    int largestInteger(int n, int s) {

        int ans = -1;
        for(int i = 0; i <= 99999; i++) {

            int num = i;
            int digitCnt = 0;
            int sum = 0;
            while(num) {

                sum += (num % 10);
                num /= 10;
                digitCnt++;
            }

            if(sum == s && (digitCnt <= n)) {
                ans = i;
            }

            if(digitCnt > n) break;
        }

        return ans;
    }
};
