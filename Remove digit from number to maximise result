class Solution {
public:
    string removeDigit(string number, char digit) {
        int n = number.size();
        int lastInd = -1;

        for(int i=0; i<n; i++){
            if(number[i] == digit){
                lastInd = i;
                //check if next digit is greater
                if(i+1 < n && number[i+1] > digit){
                    number.erase(i,1);
                    return number;
                }
            }
        }
        //if no better place found, remove the last occurence
        number.erase(lastInd, 1);
        return number;
    }
};
