class Solution {
public:
    vector<int> finalPrices(vector<int>& prices) {
        vector<int> ans;
        stack<int> st;
        int sz = prices.size();
        st.push(prices[sz - 1]);
        int i = sz - 2;

        while (i >= 0) {
            int j = i + 1;
            while (j < sz) {
                if (prices[j] <= prices[i]) {
                    st.push(prices[i] - prices[j]);
                    break;
                }
                j++;
            }
            if (j == sz) {
                st.push(prices[i]);
            }
            i--;
        }

        while (!st.empty()) {
            ans.push_back(st.top());
            st.pop();
        }
        return ans;
    }
};
