class Solution {
public:
    int smallestIndex(vector<int>& nums) {
        int n = nums.size();
        for (int i = 0; i < n; i++) {
            if (findDigits(nums[i], i))
                return i;
        }
        return -1;
    }

    bool findDigits(int num, int index) {
        int sum = 0;
        while (num > 0) {
            sum += num % 10;
            num /= 10;
        }
        return sum == index;
    }
};
