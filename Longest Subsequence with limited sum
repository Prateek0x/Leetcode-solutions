class Solution {
public:
    vector<int> answerQueries(vector<int>& nums, vector<int>& queries) {
        sort(nums.begin(),nums.end());
        int sz=nums.size();
        vector<int>pre(sz,0);
        pre[0]=nums[0];
        for(int i=1;i<sz;i++){
            pre[i]=nums[i]+pre[i-1];
        }
        vector<int>ans;
        for(auto &val:queries){
            int target=0,l=0,r=sz-1;
            while(l<=r){
                int mid=l+(r-l)/2;
                if(pre[mid]<=val){
                    target=mid+1;
                    l=mid+1;
                }
                else{
                    r=mid-1;
                }
            }
            ans.push_back(target);
        }
        return ans;
    }
};
