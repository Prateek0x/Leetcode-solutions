class Solution {
public:
    string maximumOddBinaryNumber(string s) {
        vector <int> nums;
        for(char c : s){
            int x = c - '0';
            nums.push_back(x);
        }
        vector <int> arr1;
        for(int val : nums){
            if(val == 1){
                arr1.push_back(val);
            }
        }
        vector <int> arr2;
        arr2.push_back(1);
        for(int val2 : nums){
            if(val2 == 0){
                arr2.push_back(val2);
            }
        }
        sort(arr2.begin(), arr2.end());
        arr1.pop_back();
        for(int a : arr2){
            arr1.push_back(a);
        }
        string str = "";
        for(int i = 0; i < arr1.size(); i++){
            str += to_string(arr1[i]);
        }
        return str;
    }
};
