class Solution {
public:
    // Function to compute area of triangle formed by 3 points
    double fn(long long x1,long long y1,long long x2,long long y2,long long x3,long long y3){
        return 0.5 * abs(x1*(y2-y3) + x2*(y3-y1) + x3*(y1-y2));
    }

    double largestTriangleArea(vector<vector<int>>& points) {
        double maxi = 0.0;
        int n = points.size();

        for(int i=0; i<n; i++){
            for(int j=i+1; j<n; j++){
                for(int k=j+1; k<n; k++){
                    double area = fn(points[i][0], points[i][1],
                                     points[j][0], points[j][1],
                                     points[k][0], points[k][1]);
                    maxi = max(maxi, area);
                }
            }
        }
        return maxi;
    }
};
