class Solution {
public:
    int secondsBetweenTimes(string st, string en) {
        int hour = ((en[0] - '0') * 10 + (en[1] - '0')) -
                   ((st[0] - '0') * 10 + (st[1] - '0'));

        int min = ((en[3] - '0') * 10 + (en[4] - '0')) -
                  ((st[3] - '0') * 10 + (st[4] - '0'));

        int sec = ((en[6] - '0') * 10 + (en[7] - '0')) -
                  ((st[6] - '0') * 10 + (st[7] - '0'));

        return (hour * 3600) + (min * 60) + sec;
    }
};
